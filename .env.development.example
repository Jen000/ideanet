# Dev-environment config for the AWS adapter.
#
# After deploying the dev backend (cd infra && npm run deploy:dev), copy this to
# `.env.development` and fill in the dev stack's outputs. Vite then gives you a
# clean split with no code changes:
#   npm run dev    -> development mode -> loads .env.development -> DEV backend
#   npm run build  -> production mode  -> loads .env.production  -> PROD backend
#
# These are PUBLIC client identifiers (safe to commit). `.env.development` is not
# gitignored, so committing your dev values is fine.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_BASE_URL=
