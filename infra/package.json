{
  "name": "ideanet-infra",
  "version": "0.1.0",
  "private": true,
  "bin": { "ideanet-infra": "bin/ideanet.js" },
  "scripts": {
    "build": "tsc",
    "synth:dev": "cdk synth -c env=dev",
    "synth:prod": "cdk synth -c env=prod",
    "deploy:dev": "cdk deploy -c env=dev",
    "deploy:prod": "cdk deploy -c env=prod",
    "diff:dev": "cdk diff -c env=dev",
    "diff:prod": "cdk diff -c env=prod",
    "destroy:dev": "cdk destroy -c env=dev"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.620.0",
    "@aws-sdk/client-sqs": "^3.620.0",
    "@aws-sdk/lib-dynamodb": "^3.620.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  }
}
