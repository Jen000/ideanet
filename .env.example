# Frontend config for the AWS adapter. Copy to .env and fill in from the
# outputs of `cd infra && npx cdk deploy`. .env is gitignored — never commit
# real values. These are only read when src/api/index.js points at ./aws.

VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_BASE_URL=
